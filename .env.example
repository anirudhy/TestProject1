# Without these set, the app runs entirely against an in-memory demo
# dataset (see lib/db/local-store.ts) — `pnpm dev` works out of the box.

# Public — safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only — never expose client-side. Required for seeding, the
# moderation approve/reject API routes, and the seed:verify script.
SUPABASE_SERVICE_ROLE_KEY=

SENTRY_DSN=
RESEND_API_KEY=
